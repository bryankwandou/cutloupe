{
  "name": "cutloupe-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Cutloupe: a video editor your agent can see. MCP server, live studio, and an on-chain edit ledger.",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/studio",
    "packages/mcp"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test packages/core/test/core.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "node scripts/smoke-mcp.mjs .smoke",
    "ledger:check": "node scripts/ledger-checks.mjs",
    "site": "node scripts/serve.mjs site 4400",
    "walkthrough": "node scripts/record-walkthrough.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
